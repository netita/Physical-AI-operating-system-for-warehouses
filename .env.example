# =============================================================================
# WarehouseGPT — Environment Variable Reference
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# NVIDIA / Isaac Sim / Omniverse
# -----------------------------------------------------------------------------

# API key for NVIDIA NGC (used to pull Isaac Sim containers, model checkpoints)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA Omniverse Nucleus server (for digital twin asset streaming)
OMNIVERSE_NUCLEUS_URL=omniverse://nucleus.local

# Omniverse authentication (service account)
OMNIVERSE_USER=warehousegpt-svc
OMNIVERSE_PASSWORD=change_me_strong_password

# Isaac Sim headless rendering mode: "rtx" | "iray" | "pathtracing"
ISAAC_SIM_RENDER_MODE=rtx

# Path to mounted Isaac Sim installation (when running outside the container)
ISAAC_SIM_PATH=/isaac-sim

# USD stage URL for the warehouse digital twin
WAREHOUSE_STAGE_URL=omniverse://nucleus.local/Projects/Warehouse/main.usd

# -----------------------------------------------------------------------------
# Anthropic (WarehouseGPT LLM Agent — Claude Sonnet 4.6)
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model ID — must match the deployed model in production
ANTHROPIC_MODEL=claude-sonnet-4-6

# Maximum tokens the agent may generate per turn
ANTHROPIC_MAX_TOKENS=8192

# Agent system prompt path (relative to repo root)
AGENT_SYSTEM_PROMPT_PATH=warehousegpt/apps/agent/prompts/system.md

# Maximum number of LangChain / agent reasoning iterations before aborting
AGENT_MAX_ITERATIONS=25

# -----------------------------------------------------------------------------
# API Gateway (FastAPI / Uvicorn)
# -----------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# JWT secret for operator authentication (min 64 chars, random)
API_JWT_SECRET=change_me_to_a_64_char_random_hex_value_xxxxxxxxxxxxxxxxxxxxxxxx
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRE_MINUTES=480

# CORS allowed origins (comma-separated)
API_CORS_ORIGINS=http://localhost:3000,https://dashboard.warehouse.internal

# -----------------------------------------------------------------------------
# PostgreSQL (WMS records, mission history, audit log)
# -----------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehousegpt
POSTGRES_USER=warehousegpt
POSTGRES_PASSWORD=change_me_strong_postgres_password
# Async SQLAlchemy URL (constructed automatically if not overridden)
DATABASE_URL=postgresql+asyncpg://warehousegpt:change_me_strong_postgres_password@localhost:5432/warehousegpt

# Connection pool settings
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40
POSTGRES_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Neo4j (Warehouse scene graph & spatial knowledge)
# -----------------------------------------------------------------------------

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_neo4j_password
NEO4J_DATABASE=neo4j

# Max concurrent Neo4j connections
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# -----------------------------------------------------------------------------
# ChromaDB (Vector store for semantic search & RAG)
# -----------------------------------------------------------------------------

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_WAREHOUSE=warehouse_knowledge
CHROMA_COLLECTION_PROCEDURES=sop_procedures
CHROMA_COLLECTION_INCIDENTS=incident_reports

# Embedding model used when inserting/querying ChromaDB
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Redis (Task queue, real-time state cache, pub/sub)
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1
REDIS_DB_PUBSUB=2
REDIS_URL=redis://:change_me_strong_redis_password@localhost:6379/0

# Celery broker and result backend
CELERY_BROKER_URL=redis://:change_me_strong_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_strong_redis_password@localhost:6379/1
CELERY_WORKER_CONCURRENCY=8

# -----------------------------------------------------------------------------
# NVIDIA Triton Inference Server
# -----------------------------------------------------------------------------

TRITON_GRPC_URL=localhost:8001
TRITON_HTTP_URL=http://localhost:8002
TRITON_METRICS_URL=http://localhost:8003/metrics

# Triton model repository path (bind-mounted volume)
TRITON_MODEL_REPOSITORY=/models

# Default inference timeout (seconds)
TRITON_TIMEOUT_SECONDS=10

# Triton shared memory transport: "none" | "system" | "cuda"
TRITON_SHARED_MEMORY=cuda

# -----------------------------------------------------------------------------
# TensorRT / CUDA
# -----------------------------------------------------------------------------

# CUDA visible devices (comma-separated GPU indices)
CUDA_VISIBLE_DEVICES=0,1

# TensorRT precision: "fp32" | "fp16" | "int8"
TRT_PRECISION=fp16

# TensorRT engine cache directory
TRT_ENGINE_CACHE_DIR=/models/trt_engines

# TRT workspace size in MB
TRT_WORKSPACE_MB=8192

# -----------------------------------------------------------------------------
# ROS 2 Bridge
# -----------------------------------------------------------------------------

ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0

# DDS middleware: "rmw_cyclonedds_cpp" | "rmw_fastrtps_cpp"
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Robot fleet size (used for pre-allocating ROS node connections)
AMR_FLEET_SIZE=20
MANIPULATOR_COUNT=4

# Heartbeat timeout for AMRs before declaring LOST (seconds)
AMR_HEARTBEAT_TIMEOUT_SECONDS=5

# ROS 2 topic prefix
ROS_NAMESPACE=/warehouse

# -----------------------------------------------------------------------------
# Observability — Prometheus & OpenTelemetry
# -----------------------------------------------------------------------------

PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# OpenTelemetry collector gRPC endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=warehousegpt
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,team=robotics

# Trace sampling ratio (0.0 – 1.0)
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.25

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_grafana_password

# Grafana SMTP for alert emails (optional)
GRAFANA_SMTP_HOST=smtp.warehouse.internal
GRAFANA_SMTP_PORT=587
GRAFANA_SMTP_USER=grafana@warehouse.internal
GRAFANA_SMTP_PASSWORD=change_me_smtp_password
GRAFANA_SMTP_FROM=grafana@warehouse.internal

# Alertmanager — Gmail SMTP for warehouse alert emails
# ALERT_GMAIL_FROM: the Gmail address alerts are sent FROM
# Get App Password: https://myaccount.google.com/apppasswords (requires 2FA)
ALERT_GMAIL_FROM=your-gmail@gmail.com
ALERT_GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ALERT_EMAIL_TO=your-email@example.com

# -----------------------------------------------------------------------------
# Warehouse Management System (WMS) Integration
# -----------------------------------------------------------------------------

# External WMS REST endpoint (SAP EWM / Blue Yonder / etc.)
WMS_API_URL=https://wms.warehouse.internal/api/v2
WMS_API_KEY=change_me_wms_api_key
WMS_API_TIMEOUT_SECONDS=15

# WMS webhook receiver secret (HMAC-SHA256)
WMS_WEBHOOK_SECRET=change_me_wms_webhook_secret

# Polling interval for WMS task feed (seconds)
WMS_POLL_INTERVAL_SECONDS=10

# -----------------------------------------------------------------------------
# Safety & Emergency Stop
# -----------------------------------------------------------------------------

# E-stop MQTT broker for hardware-level safety signals
ESTOP_MQTT_BROKER=mqtt://safety-broker.warehouse.internal:1883
ESTOP_MQTT_TOPIC=warehouse/estop
ESTOP_MQTT_QOS=2

# Maximum linear velocity allowed for AMRs (m/s)
AMR_MAX_VELOCITY_MS=2.0

# Minimum battery level before forcing AMR to charging dock (%)
AMR_LOW_BATTERY_THRESHOLD_PCT=15

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable GPU-accelerated point cloud processing
FEATURE_GPU_POINTCLOUD=true

# Enable synthetic data augmentation during inference (test-time augmentation)
FEATURE_TTA=false

# Enable WarehouseGPT proactive suggestions (agent-initiated messages)
FEATURE_PROACTIVE_AGENT=true

# Enable multi-agent coordination (experimental)
FEATURE_MULTI_AGENT=false

# Enable Isaac Sim digital twin streaming
FEATURE_DIGITAL_TWIN_STREAM=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Structured log sink (optional — send to external aggregator)
LOG_LOKI_URL=http://loki.warehouse.internal:3100/loki/api/v1/push

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Encryption key for secrets stored in Postgres (Fernet-compatible, 32 bytes base64url)
SECRET_ENCRYPTION_KEY=change_me_32_byte_base64url_encoded_key=

# TLS certificate paths (for mTLS between services)
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
TLS_CA_FILE=/certs/ca.crt

# Rate limiting (requests per minute per operator token)
API_RATE_LIMIT_PER_MIN=600

# ============================================================
# WarehouseGPT Agent Service Image
# Claude-powered NL interface + fleet orchestration API
# ============================================================
# Build (from repo root):
#   docker build \
#     -f deployment/docker/Dockerfile.agent \
#     -t warehousegpt/agent:latest \
#     --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) \
#     --build-arg GIT_SHA=$(git rev-parse --short HEAD) \
#     .
# ============================================================

ARG BASE_IMAGE=warehousegpt/base:24.12
FROM ${BASE_IMAGE}

ARG BUILD_DATE
ARG GIT_SHA
ARG VERSION=1.0.0

LABEL org.opencontainers.image.title="WarehouseGPT Agent" \
      org.opencontainers.image.description="Claude Sonnet 4.6-powered warehouse orchestration agent API" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.vendor="WarehouseGPT" \
      org.opencontainers.image.licenses="Proprietary"

# ---- Switch to root for installation ----
USER root

# ---- Install package in editable mode ----
# Copy dependency declarations first for better layer caching
COPY pyproject.toml /app/pyproject.toml

# Copy application source
COPY warehousegpt/ /app/warehousegpt/

# Install the package (without optional extras — base only)
RUN pip install --no-cache-dir -e /app[inference]

# ---- Copy runtime configuration ----
COPY deployment/docker/config/agent/ /app/config/

# ---- Alembic migrations ----
COPY alembic.ini /app/alembic.ini
COPY migrations/ /app/migrations/

# ---- Static assets (OpenAPI docs, etc.) ----
COPY warehousegpt/apps/agent/static/ /app/static/ 2>/dev/null || true

# ---- Healthcheck script ----
COPY deployment/docker/scripts/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/healthcheck.sh

# ---- Switch to non-root ----
USER warehousegpt

# ---- Runtime environment defaults ----
# These are overridden by Kubernetes env/secrets
ENV PORT=8000 \
    WORKERS=4 \
    LOG_LEVEL=info \
    ENVIRONMENT=production \
    ANTHROPIC_MODEL=claude-sonnet-4-6 \
    ANTHROPIC_MAX_TOKENS=8192 \
    ENABLE_OTEL=true \
    OTEL_SERVICE_NAME=warehousegpt-agent \
    PYTHONPATH=/app

# Expose API port and Prometheus metrics port
EXPOSE 8000 9092

# ---- Healthcheck (Docker native — Kubernetes uses its own probes) ----
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh http://localhost:${PORT}/health/live

# ---- Default command — uvicorn with production settings ----
CMD ["uvicorn", "warehousegpt.apps.agent.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--loop", "uvloop", \
     "--http", "httptools", \
     "--access-log", \
     "--log-level", "info", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]

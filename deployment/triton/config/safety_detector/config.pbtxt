# ============================================================
# Triton Model Configuration — YOLOv8 Safety Detector
# Real-time detection of PPE, zone violations, near-misses,
# worker proximity to forklifts, fire/smoke
# ============================================================

name: "safety_detector"
backend: "tensorrt"
max_batch_size: 16

# ----------------------------------------------------------
# Input tensors
# ----------------------------------------------------------
input [
  {
    # Multi-camera image batch, resized to 640x640 (YOLOv8 standard)
    # Normalized to [0,1], BGR channel order to match YOLO training
    name: "images"
    data_type: TYPE_FP16
    format: FORMAT_NCHW
    dims: [ 3, 640, 640 ]
  },
  {
    # Optional per-image confidence threshold overrides
    # Shape: [batch] — if set to 0.0 uses model default (0.35)
    name: "confidence_threshold"
    data_type: TYPE_FP32
    dims: [ 1 ]
    optional: true
  }
]

# ----------------------------------------------------------
# Output tensors
# ----------------------------------------------------------
output [
  {
    # Detection boxes in XYXY format, normalized [0,1]
    # Shape: [batch, max_detections, 4]
    # max_detections: 300 (post-NMS)
    name: "detection_boxes"
    data_type: TYPE_FP32
    dims: [ 300, 4 ]
  },
  {
    # Detection scores (post-NMS)
    # Shape: [batch, max_detections]
    name: "detection_scores"
    data_type: TYPE_FP32
    dims: [ 300 ]
  },
  {
    # Class IDs:
    #   0: person_no_helmet
    #   1: person_no_vest
    #   2: forklift
    #   3: person
    #   4: person_in_danger_zone
    #   5: near_miss_event
    #   6: fire
    #   7: smoke
    #   8: spill_hazard
    #   9: unauthorized_access
    #  10: person_in_restricted_zone
    #  11: collision_imminent
    name: "detection_classes"
    data_type: TYPE_INT32
    dims: [ 300 ]
  },
  {
    # Number of valid detections per image (post-NMS)
    name: "num_detections"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    # Feature maps for downstream tracking (optional)
    # Shape: [batch, 256, 80, 80] — stride 8 feature map
    name: "feature_map_s8"
    data_type: TYPE_FP16
    dims: [ 256, 80, 80 ]
  },
  {
    # Per-detection keypoints (17 COCO body keypoints for pose)
    # Shape: [batch, max_detections, 17, 3] (x, y, conf)
    name: "keypoints"
    data_type: TYPE_FP32
    dims: [ 300, 17, 3 ]
  }
]

# ----------------------------------------------------------
# Dynamic batching
# ----------------------------------------------------------
dynamic_batching {
  preferred_batch_size: [ 1, 2, 4, 8, 16 ]
  # Max 2ms queue wait — safety inference must be near-real-time
  max_queue_delay_microseconds: 2000

  default_queue_policy {
    allow_timeout_override: false
    timeout_action: REJECT
    default_timeout_microseconds: 20000  # 20ms hard timeout
    max_queue_size: 128
  }

  # Priority queues: SAFETY_CRITICAL frames get elevated priority
  priority_queue_policy {
    key: 1  # NORMAL
    value {
      timeout_action: DELAY
      default_timeout_microseconds: 20000
      max_queue_size: 64
    }
  }
  priority_queue_policy {
    key: 2  # HIGH (safety-critical cameras)
    value {
      timeout_action: REJECT
      default_timeout_microseconds: 10000
      max_queue_size: 32
    }
  }
}

# ----------------------------------------------------------
# Instance group — 2 GPU instances
# ----------------------------------------------------------
instance_group [
  {
    name: "safety_detector_gpu"
    count: 2
    kind: KIND_GPU
    gpus: [ 0, 1 ]
  }
]

# ----------------------------------------------------------
# Optimization — TensorRT INT8 for maximum throughput
# ----------------------------------------------------------
optimization {
  execution_accelerators {
    gpu_execution_accelerator: [
      {
        name: "tensorrt"
        parameters {
          key: "precision_mode"
          value: "FP16"
        }
        parameters {
          key: "max_workspace_size_bytes"
          value: "2147483648"  # 2 GiB
        }
        parameters {
          key: "trt_engine_cache_enable"
          value: "1"
        }
        parameters {
          key: "trt_engine_cache_path"
          value: "/tmp/trt_cache/safety_detector"
        }
        # YOLO-specific: use CUDNN for conv layers
        parameters {
          key: "trt_detailed_build_log"
          value: "0"
        }
      }
    ]
  }
  input_pinned_memory { enable: true }
  output_pinned_memory { enable: true }
  # CUDA streams for parallel batch processing
  cuda {
    graphs: true
    busy_wait_events: true
    graph_spec [
      { batch_size: 1 },
      { batch_size: 4 },
      { batch_size: 8 },
      { batch_size: 16 }
    ]
    output_copy_stream: true
  }
}

# ----------------------------------------------------------
# Model warmup
# ----------------------------------------------------------
model_warmup [
  {
    name: "safety_detector_warmup_batch1"
    batch_size: 1
    inputs {
      key: "images"
      value {
        data_type: TYPE_FP16
        dims: [ 1, 3, 640, 640 ]
        zero_data: false
        random_data: true
      }
    }
  },
  {
    name: "safety_detector_warmup_batch8"
    batch_size: 8
    inputs {
      key: "images"
      value {
        data_type: TYPE_FP16
        dims: [ 8, 3, 640, 640 ]
        zero_data: false
        random_data: true
      }
    }
  }
]

# ----------------------------------------------------------
# Model version policy
# ----------------------------------------------------------
version_policy {
  latest {
    num_versions: 2
  }
}

# ----------------------------------------------------------
# Parameters — NMS post-processing settings
# ----------------------------------------------------------
parameters {
  key: "NMS_CONF_THRESHOLD"
  value { string_value: "0.35" }
}
parameters {
  key: "NMS_IOU_THRESHOLD"
  value { string_value: "0.45" }
}
parameters {
  key: "MAX_DETECTIONS"
  value { string_value: "300" }
}
parameters {
  key: "INPUT_SIZE"
  value { string_value: "640" }
}
parameters {
  key: "NUM_CLASSES"
  value { string_value: "12" }
}
parameters {
  key: "ENABLE_POSE"
  value { string_value: "true" }
}
parameters {
  key: "TARGET_LATENCY_MS"
  value { string_value: "50" }
}
